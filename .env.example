# Copy to .env.local and fill from Firebase console → Project settings → Your apps → Web app.
# These are public identifiers (they ship in the browser bundle); security comes from firestore.rules.
# Leave them empty to run in local demo mode.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=
