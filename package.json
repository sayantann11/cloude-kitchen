{
  "name": "mahanadi-kitchen",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Ordering app + kitchen dashboard with smart order batching and delivery routing for a cloud kitchen in Sambalpur.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 4173 --strictPort",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "icons": "node scripts/make-icons.mjs",
    "check": "npm run typecheck && npm run test && npm run build && npm run e2e",
    "deploy": "npm run build && firebase deploy --only hosting,firestore"
  },
  "dependencies": {
    "@preact/signals": "^1.3.0",
    "firebase": "^11.0.0",
    "leaflet": "^1.9.4",
    "preact": "^10.24.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.48.0",
    "@preact/preset-vite": "^2.9.0",
    "@types/leaflet": "^1.9.12",
    "firebase-tools": "^13.35.1",
    "typescript": "~5.6.0",
    "vite": "^5.4.0",
    "vitest": "^2.1.0"
  }
}
